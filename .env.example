# ============================================================
# LM COUPES — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

PORT=3000
ADMIN_PASSWORD=Sturbain1234
SESSION_SECRET=replace_with_a_long_random_secret_string

# Path where bookings.db and sessions/ are stored.
# On Railway, set this to /data (your mounted volume path).
# Leave empty for local development.
DATA_DIR=

# ---- GOOGLE CALENDAR ----------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local:      http://localhost:3000/oauth/callback
# Production: https://lmcoupes.ca/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Toronto

# ---- EMAIL --------------------------------------------------
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=LM Coupes
